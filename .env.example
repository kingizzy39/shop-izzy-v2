# Shop Izzy v2 - Environment Variables
# Copy this file to .env.local and fill in your values

# Unsplash API (for high-quality product images)
# Get your free access key at: https://unsplash.com/developers
# VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# API Configuration (for future backend integration)
# VITE_API_URL=http://localhost:3000/api

# Feature Flags
# VITE_ENABLE_PWA=true
# VITE_ENABLE_ANALYTICS=false

# Payment Gateway (for future integration)
# VITE_PAYSTACK_PUBLIC_KEY=your_paystack_key
# VITE_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_key

# ============================================
# MONITORING CONFIGURATION
# ============================================

# Sentry (Error Tracking & Performance Monitoring)
# Get your DSN at: https://sentry.io/settings/projects/
# VITE_SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/123456
# VITE_SENTRY_ENVIRONMENT=development|staging|production
# VITE_APP_VERSION=1.0.0

# Sentry CLI (for source map uploads - set in CI/CD)
# SENTRY_AUTH_TOKEN=your_auth_token
# SENTRY_ORG=your_org_slug
# SENTRY_PROJECT=your_project_slug

# PostHog (Product Analytics)
# Get your API key at: https://app.posthog.com/project/settings
# VITE_POSTHOG_API_KEY=phc_your_api_key_here
# VITE_POSTHOG_HOST=https://app.posthog.com (or your self-hosted URL)